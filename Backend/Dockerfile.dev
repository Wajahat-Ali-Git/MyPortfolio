# =============================================================================
# Development Dockerfile with Hot Reload
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Install development dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY src ./src

# Expose port
EXPOSE 5000

# Development environment
ENV NODE_ENV=development

# Use nodemon for hot reload
CMD ["npm", "run", "dev"]
