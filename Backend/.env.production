# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Set these as environment variables in your hosting platform.
# NEVER commit this file with real values filled in.
# Variables marked REQUIRED must be set before deploying.
# =============================================================================

NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# Supabase — REQUIRED
# Get from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=                          # REQUIRED: https://your-ref.supabase.co
SUPABASE_ANON_KEY=                     # REQUIRED: anon/public key
SUPABASE_SERVICE_ROLE_KEY=             # REQUIRED: service_role key (⚠️ never expose to browser)

# -----------------------------------------------------------------------------
# Database (alternative to Supabase — only needed if NOT using Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL=                          # Optional: postgres://user:pass@host:port/db

# -----------------------------------------------------------------------------
# CORS — REQUIRED: replace with your actual frontend domain(s)
# Multiple origins: comma-separated, e.g. https://mysite.com,https://www.mysite.com
# -----------------------------------------------------------------------------
CORS_ORIGIN=                           # REQUIRED: https://yourportfolio.com
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000            # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Security — REQUIRED
# API_KEY: generate a strong random string, e.g. openssl rand -hex 32
# JWT_SECRET: used for any custom JWT signing (if applicable)
# -----------------------------------------------------------------------------
API_KEY=                               # REQUIRED: strong random secret
JWT_SECRET=                            # REQUIRED: strong random secret
ENCRYPTION_KEY=                        # Optional

# -----------------------------------------------------------------------------
# Debug / Logging
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# GitHub — optional but recommended for the /api/github/sync endpoint
# Generate at: https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_USERNAME=Wajahat-Ali-Git
GITHUB_TOKEN=                          # Optional: ghp_... personal access token

# -----------------------------------------------------------------------------
# Email (SMTP) — optional, for contact form email notifications
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_CONTACT_FORM=true
ENABLE_BLOG=false
ENABLE_COMMENTS=false
