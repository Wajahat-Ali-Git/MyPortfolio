{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Portfolio Backend API with Supabase integration",
  "main": "src/index.js",
  "scripts": {
    "setup": "node setup-env.js",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test-db": "node test-db-connection.js",
    "migrate": "node database/migrate.js",
    "migrate:portfolio": "node database/migrate.js schema-portfolio-content.sql",
    "migrate:supabase-rpc": "node database/migrate.js schema-supabase-rpc.sql",
    "migrate:all": "npm run migrate:portfolio && npm run migrate:supabase-rpc",
    "db:reset": "node database/migrate.js schema-portfolio-content.sql",
    "seed": "node database/seed-data.js",
    "db:fresh": "npm run migrate:all && npm run seed"
  },
  "keywords": [
    "portfolio",
    "backend",
    "supabase",
    "express",
    "api"
  ],
  "author": "Wajahat Ali",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
