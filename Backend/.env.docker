# =============================================================================
# DOCKER ENVIRONMENT VARIABLES
# =============================================================================
# These are used by docker-compose.yml
# Copy to .env.docker.local and customize for your setup
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_password_change_me

# Backend API
NODE_ENV=development
PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin API Key
API_KEY=your_secure_api_key_change_me

# Supabase (Optional - for cloud sync/backup)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# pgAdmin (Optional)
PGADMIN_DEFAULT_EMAIL=admin@portfolio.local
PGADMIN_DEFAULT_PASSWORD=admin

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.docker .env.docker.local
# 2. Update the passwords and API keys
# 3. Run: docker-compose up
# =============================================================================
